define method .beforeCellUpdate(!data is ARRAY)
	q var !data
	!this.grid.doDabaconCellUpdate(!data)

endmethod

define method .checkStatus()
  using namespace 'Aveva.Core.Presentation'
  !NumberOfRecords = !this.grid.getNumberRows()
  if !NumberOfRecords eq 0 then
    !!alert.error( |No data loaded. Please load data first.| )
  else
    !headers = object Array()
    !headers.append('GPART')
    !headers.append('GPART STATUS')
    !headers.append('SCOM')
    !headers.append('SCOM STATUS')
    !headers.append('CATE')
    !headers.append('CATE STATUS')
    !this.statusRows = object Array()
    DO !n FROM 1 TO !NumberOfRecords
      !CurrentValues = !this.grid.getRow('$!n')
      !RecGpart    = !CurrentValues[1]
      !RecScom     = !CurrentValues[16]
      !RecCateCode = !CurrentValues[14]
      !gpartStatus = 'NEW'
      /$!RecGpart
      handle ANY
      elsehandle none
        !gpartStatus = 'EXIST'
      endhandle
      !scomStatus = 'NEW'
      /$!RecScom
      handle ANY
      elsehandle none
        !scomStatus = 'EXIST'
      endhandle
      !cateStatus = 'NEW'
      /$!RecCateCode
      handle ANY
      elsehandle none
        !cateStatus = 'EXIST'
      endhandle
      !row = object Array()
      !row.append(!RecGpart)
      !row.append(!gpartStatus)
      !row.append(!RecScom)
      !row.append(!scomStatus)
      !row.append(!RecCateCode)
      !row.append(!cateStatus)
      !this.statusRows.append(!row)
    ENDDO
    !nds = object NETDATASOURCE('Status Check', !headers, !this.statusRows)
    !this.resultGrid.clearGrid()
    !this.resultGrid.BindToDataSource(!nds)
    !this.resultGrid.autoFitColumns()
    handle ANY
    endhandle
  endif
endmethod

define method .exportResults()
  if !this.statusRows.size() eq 0 then
    !!alert.error( |No status data. Run Check Status first.| )
  else
    import 'PMLFileBrowser'
    handle ANY
    endhandle
    using namespace 'Aveva.Core.Presentation'
    !browser = object PMLFILEBROWSER('SAVE')
    !browser.show('C:\','status_check','Export Status',true,'CSV Files|*.csv',1)
    !filePath = !browser.file()
    if !filePath neq '' then
      !lines = object Array()
      !lines.append('GPART,GPART STATUS,SCOM,SCOM STATUS,CATE,CATE STATUS')
      DO !n FROM 1 TO !this.statusRows.size()
        !row  = !this.statusRows[!n]
        !line = !row[1] + ',' + !row[2] + ',' + !row[3] + ',' + !row[4] + ',' + !row[5] + ',' + !row[6]
        !lines.append(!line)
      ENDDO
      !file = object File(!filePath)
      !file.WriteFile(!lines)
      !!alert.error( |Export complete: $!!filePath| )
    endif
  endif
endmethod
